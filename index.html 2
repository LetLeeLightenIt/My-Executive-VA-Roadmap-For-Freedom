<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Device → Income</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Fraunces:ital,wght@0,300;0,700;1,300&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --fire: #E8420A;
  --amber: #F5A623;
  --gold: #C9A84C;
  --gold-light: #E8C97A;
  --cream: #F2EDE4;
  --dark: #080808;
  --card: #101010;
  --card2: #161616;
  --border: #1E1E1E;
  --muted: #555;
  --text: #E0DBD3;
  --accent: #3A7BD5;
  --green: #2ECC8A;
  --pink: #C0395A;
}

html { scroll-behavior: smooth; }
body {
  background: var(--dark);
  color: var(--text);
  font-family: 'Fraunces', Georgia, serif;
  overflow-x: hidden;
}

/* ─── PAGES ─── */
.page { display: none; min-height: 100vh; }
.page.active { display: block; animation: pageIn 0.5s cubic-bezier(0.22,1,0.36,1) both; }
@keyframes pageIn {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ─── NAV ─── */
.nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 999;
  display: flex; justify-content: space-between; align-items: center;
  padding: 0 40px;
  height: 60px;
  background: rgba(8,8,8,0.9);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border);
}
.nav-logo {
  font-family: 'DM Mono', monospace;
  font-size: 12px;
  letter-spacing: 3px;
  color: var(--fire);
  text-transform: uppercase;
  cursor: pointer;
}
.nav-links { display: flex; gap: 8px; }
.nav-btn {
  font-family: 'DM Mono', monospace;
  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;
  padding: 8px 20px;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  transition: all 0.2s;
  border-radius: 2px;
}
.nav-btn:hover, .nav-btn.active-tab {
  color: var(--cream);
  border-color: rgba(232,66,10,0.5);
  background: rgba(232,66,10,0.07);
}

/* ─── HERO ─── */
.hero {
  min-height: 100vh;
  display: flex; flex-direction: column; justify-content: center;
  padding: 100px 60px 80px;
  position: relative; overflow: hidden;
}
.hero-glow {
  position: absolute; inset: 0; pointer-events: none;
  background:
    radial-gradient(ellipse 60% 50% at 10% 60%, rgba(232,66,10,0.06), transparent),
    radial-gradient(ellipse 40% 40% at 85% 20%, rgba(245,166,35,0.04), transparent);
}
.hero-grid {
  position: absolute; inset: 0; pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
  background-size: 60px 60px;
  mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black, transparent);
}

.hero-eyebrow {
  font-family: 'DM Mono', monospace;
  font-size: 11px;
  letter-spacing: 4px;
  color: var(--fire);
  text-transform: uppercase;
  margin-bottom: 28px;
  display: flex; align-items: center; gap: 14px;
  animation: up 0.7s ease both;
}
.hero-eyebrow::before {
  content: '';
  width: 32px; height: 1px;
  background: var(--fire);
}

.hero-h1 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(80px, 14vw, 160px);
  line-height: 0.88;
  letter-spacing: 1px;
  animation: up 0.7s ease 0.1s both;
}
.hero-h1 .stroke {
  -webkit-text-stroke: 1.5px rgba(242,237,228,0.2);
  color: transparent;
}
.hero-h1 .hot { color: var(--fire); }

.hero-sub {
  margin-top: 32px;
  font-size: clamp(18px, 2.5vw, 24px);
  font-style: italic;
  font-weight: 300;
  color: rgba(224,219,211,0.55);
  max-width: 500px;
  line-height: 1.45;
  animation: up 0.7s ease 0.2s both;
}

.hero-devices {
  margin-top: 48px;
  display: flex; gap: 12px; flex-wrap: wrap;
  animation: up 0.7s ease 0.3s both;
}
.d-chip {
  font-family: 'DM Mono', monospace;
  font-size: 11px;
  letter-spacing: 2px;
  padding: 9px 18px;
  border: 1px solid rgba(232,66,10,0.25);
  color: rgba(245,166,35,0.85);
  background: rgba(232,66,10,0.04);
  border-radius: 2px;
}

.hero-cta {
  margin-top: 56px;
  animation: up 0.7s ease 0.4s both;
}
.btn-primary {
  display: inline-flex; align-items: center; gap: 12px;
  font-family: 'DM Mono', monospace;
  font-size: 12px; letter-spacing: 3px; text-transform: uppercase;
  padding: 16px 36px;
  background: var(--fire); color: #fff;
  border: none; cursor: pointer;
  border-radius: 2px;
  transition: background 0.2s, transform 0.2s;
  position: relative; overflow: hidden;
}
.btn-primary:hover { background: #ff5520; transform: translateY(-1px); }
.btn-primary .arrow { transition: transform 0.2s; }
.btn-primary:hover .arrow { transform: translateX(4px); }

.btn-ghost {
  display: inline-flex; align-items: center; gap: 10px;
  font-family: 'DM Mono', monospace;
  font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
  padding: 14px 28px;
  background: transparent; color: var(--muted);
  border: 1px solid var(--border); cursor: pointer;
  border-radius: 2px;
  transition: all 0.2s;
}
.btn-ghost:hover { color: var(--cream); border-color: var(--muted); }

@keyframes up {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ─── TICKER ─── */
.ticker {
  height: 44px; overflow: hidden;
  background: var(--fire);
  display: flex; align-items: center;
}
.ticker-track {
  display: flex; white-space: nowrap;
  animation: tick 22s linear infinite;
}
.ticker-item {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 15px; letter-spacing: 3px;
  color: #fff; padding: 0 28px;
  opacity: 0.9;
}
.ticker-dot { color: rgba(255,255,255,0.4); }
@keyframes tick {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

/* ─── SECTION ─── */
.section { padding: 100px 60px; max-width: 1100px; margin: 0 auto; }
.section-sm { padding: 80px 60px; }

.eyebrow {
  font-family: 'DM Mono', monospace;
  font-size: 10px; letter-spacing: 4px; text-transform: uppercase;
  color: var(--fire); margin-bottom: 20px;
  display: flex; align-items: center; gap: 12px;
}
.eyebrow::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, rgba(232,66,10,0.3), transparent); max-width: 120px; }

.display-heading {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(44px, 7vw, 88px);
  letter-spacing: 1px; line-height: 0.95;
}
.display-heading .fire { color: var(--fire); }
.display-heading .stroke {
  -webkit-text-stroke: 1px rgba(242,237,228,0.2);
  color: transparent;
}

.body-lg {
  font-size: clamp(18px, 2vw, 22px);
  font-weight: 300; font-style: italic;
  color: rgba(224,219,211,0.55);
  line-height: 1.5; max-width: 560px;
  margin-top: 20px;
}

/* ─── STATEMENT ROW ─── */
.statements {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  margin: 60px 0;
}
.statement {
  background: var(--dark);
  padding: 40px 32px;
  transition: background 0.2s;
}
.statement:hover { background: var(--card); }
.statement-num {
  font-family: 'DM Mono', monospace;
  font-size: 10px; letter-spacing: 3px;
  color: var(--fire); margin-bottom: 16px;
}
.statement-head {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 26px; letter-spacing: 1px;
  line-height: 1.1; margin-bottom: 12px;
}
.statement-head .accent { color: var(--fire); }
.statement-body {
  font-size: 15px; font-weight: 300;
  color: rgba(224,219,211,0.5);
  line-height: 1.6;
}

/* ─── STAT ROW ─── */
.stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1px; background: var(--border);
  border: 1px solid var(--border);
}
.stat {
  background: var(--card);
  padding: 40px 28px; text-align: center;
}
.stat-num {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 56px; color: var(--fire);
  line-height: 1; display: block;
}
.stat-label {
  font-family: 'DM Mono', monospace;
  font-size: 10px; letter-spacing: 2px;
  color: var(--muted); text-transform: uppercase;
  margin-top: 8px; display: block;
  line-height: 1.5;
}

/* ─── PULL QUOTE ─── */
.pull-quote {
  padding: 80px 60px;
  background: var(--card);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  text-align: center; position: relative; overflow: hidden;
}
.pull-quote::before {
  content: '\201C';
  position: absolute; top: -60px; left: 50%; transform: translateX(-50%);
  font-family: 'Bebas Neue', sans-serif;
  font-size: 320px; color: rgba(232,66,10,0.04);
  pointer-events: none; line-height: 1;
}
.quote-text {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(32px, 6vw, 68px);
  line-height: 1.05; letter-spacing: 1px;
  max-width: 900px; margin: 0 auto;
  position: relative;
}
.quote-text .fire { color: var(--fire); }
.quote-by {
  font-family: 'DM Mono', monospace;
  font-size: 10px; letter-spacing: 4px;
  color: var(--muted); text-transform: uppercase;
  margin-top: 24px;
}

/* ─── DEVICE GRID ─── */
.device-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1px; background: var(--border);
  border: 1px solid var(--border);
  margin-top: 48px;
}
.device-block {
  background: var(--card);
  padding: 40px 32px;
  transition: background 0.25s;
  position: relative; overflow: hidden;
}
.device-block:hover { background: var(--card2); }
.device-block::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, var(--fire), var(--amber));
  transform: scaleX(0); transform-origin: left;
  transition: transform 0.35s ease;
}
.device-block:hover::before { transform: scaleX(1); }
.device-emoji { font-size: 36px; margin-bottom: 18px; display: block; }
.device-name {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 24px; letter-spacing: 2px; margin-bottom: 6px;
}
.device-tagline {
  font-style: italic; font-size: 13px;
  color: var(--amber); margin-bottom: 20px;
}
.device-list { list-style: none; }
.device-list li {
  font-size: 14px; font-weight: 300;
  color: rgba(224,219,211,0.5);
  padding: 6px 0;
  border-bottom: 1px solid var(--border);
  display: flex; gap: 10px; align-items: baseline;
}
.device-list li:last-child { border-bottom: none; }
.device-list li::before {
  content: '→';
  font-family: 'DM Mono', monospace;
  font-size: 10px; color: var(--fire);
  flex-shrink: 0;
}

/* ─── PLEDGE ─── */
.pledge-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px; margin-top: 48px;
}
.pledge {
  border: 1px solid var(--border);
  padding: 28px 24px;
  border-radius: 2px;
  background: var(--card);
  position: relative;
  opacity: 0; transform: translateY(12px);
  transition: opacity 0.5s ease, transform 0.5s ease;
}
.pledge.vis { opacity: 1; transform: translateY(0); }
.pledge-check {
  font-family: 'DM Mono', monospace;
  font-size: 10px; color: var(--fire);
  letter-spacing: 2px; margin-bottom: 12px;
}
.pledge-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 20px; letter-spacing: 1px;
  color: var(--amber); margin-bottom: 8px;
}
.pledge-body {
  font-size: 14px; font-weight: 300;
  color: rgba(224,219,211,0.5);
  line-height: 1.6;
}

/* ─── CTA CLOSER ─── */
.cta-closer {
  text-align: center;
  padding: 100px 60px;
  background: linear-gradient(to bottom, var(--dark), #0c0400);
  position: relative; overflow: hidden;
}
.cta-closer::before {
  content: 'GO';
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%,-50%);
  font-family: 'Bebas Neue', sans-serif;
  font-size: 50vw; line-height: 1;
  color: rgba(232,66,10,0.025);
  pointer-events: none; white-space: nowrap;
}
.cta-closer-h {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(64px, 13vw, 140px);
  line-height: 0.88; letter-spacing: 2px;
  position: relative;
}
.cta-closer-h .fire { color: var(--fire); }
.cta-closer-h .stroke {
  -webkit-text-stroke: 1px rgba(242,237,228,0.15);
  color: transparent;
}
.cta-closer-sub {
  font-style: italic; font-weight: 300;
  font-size: clamp(17px, 2vw, 21px);
  color: rgba(224,219,211,0.4);
  margin: 20px 0 40px;
}
.btn-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

/* ═══════════════════════════════════════
   ROADMAP PAGE
═══════════════════════════════════════ */

/* ROADMAP HERO */
.rm-hero {
  min-height: 50vh;
  display: flex; flex-direction: column; justify-content: flex-end;
  padding: 100px 60px 60px;
  background:
    radial-gradient(ellipse 50% 60% at 80% 40%, rgba(201,168,76,0.05), transparent),
    linear-gradient(180deg, #080808 0%, #0a0900 100%);
  border-bottom: 1px solid var(--border);
  position: relative; overflow: hidden;
}
.rm-hero::before {
  content: 'EVA';
  position: absolute; right: -20px; bottom: -40px;
  font-family: 'Bebas Neue', sans-serif;
  font-size: 28vw; line-height: 1;
  color: rgba(201,168,76,0.03);
  pointer-events: none;
}
.rm-hero-label {
  font-family: 'DM Mono', monospace;
  font-size: 10px; letter-spacing: 4px;
  color: var(--gold); text-transform: uppercase;
  margin-bottom: 20px;
  display: flex; align-items: center; gap: 12px;
}
.rm-hero-label::before { content: ''; width: 24px; height: 1px; background: var(--gold); }
.rm-hero h1 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(56px, 10vw, 120px);
  line-height: 0.9; letter-spacing: 1px;
}
.rm-hero h1 span { color: var(--gold); }
.rm-hero-sub {
  font-style: italic; font-weight: 300;
  font-size: 18px; color: rgba(224,219,211,0.45);
  margin-top: 16px; max-width: 480px;
}
.rm-chips { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 28px; }
.rm-chip {
  font-family: 'DM Mono', monospace;
  font-size: 10px; letter-spacing: 2px;
  padding: 7px 16px;
  border: 1px solid rgba(201,168,76,0.25);
  color: rgba(232,201,122,0.8);
  background: rgba(201,168,76,0.04);
  border-radius: 2px;
}

/* PHASE */
.phase-section { padding: 60px 60px 0; max-width: 1100px; margin: 0 auto; }
.phase-head {
  display: flex; align-items: center; gap: 20px;
  margin-bottom: 28px;
}
.phase-badge {
  width: 44px; height: 44px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Bebas Neue', sans-serif; font-size: 20px;
  flex-shrink: 0;
}
.ph-gold { background: var(--gold); color: #000; }
.ph-blue { background: var(--accent); color: #fff; }
.ph-pink { background: var(--pink); color: #fff; }
.ph-green { background: var(--green); color: #000; }

.phase-title { font-family: 'Bebas Neue', sans-serif; font-size: 28px; letter-spacing: 1px; }
.phase-sub { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 2px; color: var(--muted); margin-top: 3px; text-transform: uppercase; }

/* SKILL GRID */
.skill-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1px; background: var(--border);
  border: 1px solid var(--border);
  margin-bottom: 24px;
}
.skill-card {
  background: var(--card);
  padding: 28px 24px;
  transition: background 0.2s;
}
.skill-card:hover { background: var(--card2); }
.skill-icon { font-size: 24px; margin-bottom: 12px; display: block; }
.skill-name { font-family: 'Bebas Neue', sans-serif; font-size: 18px; letter-spacing: 1px; margin-bottom: 6px; }
.skill-desc { font-size: 13px; font-weight: 300; color: rgba(224,219,211,0.5); line-height: 1.55; }
.tag-row { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 10px; }
.tag {
  font-family: 'DM Mono', monospace;
  font-size: 9px; letter-spacing: 1px;
  padding: 3px 9px; border-radius: 2px;
}
.tg { background: rgba(201,168,76,0.1); color: var(--gold-light); border: 1px solid rgba(201,168,76,0.2); }
.tb { background: rgba(58,123,213,0.1); color: #7ab0f0; border: 1px solid rgba(58,123,213,0.2); }
.tr { background: rgba(192,57,90,0.1); color: #e8809a; border: 1px solid rgba(192,57,90,0.2); }
.tgreen { background: rgba(46,204,138,0.1); color: #7ae8b4; border: 1px solid rgba(46,204,138,0.2); }

/* APPS */
.apps-label {
  font-family: 'DM Mono', monospace;
  font-size: 10px; letter-spacing: 3px; text-transform: uppercase;
  color: var(--gold); margin-bottom: 16px;
  padding: 0 60px; max-width: 1100px; margin-left: auto; margin-right: auto;
}
.apps-strip {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 1px; background: var(--border);
  border: 1px solid var(--border);
  margin: 0 60px 0;
  max-width: calc(1100px - 0px);
}
.app-cell {
  background: var(--card2);
  padding: 18px 20px;
  display: flex; gap: 14px;
}
.app-em { font-size: 20px; flex-shrink: 0; margin-top: 2px; }
.app-n { font-family: 'DM Mono', monospace; font-size: 12px; font-weight: 500; color: var(--text); }
.app-u { font-size: 12px; color: var(--muted); margin-top: 2px; }
.app-d { font-size: 10px; color: var(--gold); margin-top: 4px; letter-spacing: 0.5px; }

/* DIVIDER */
.rm-divider { height: 1px; background: var(--border); margin: 60px 60px; }

/* INCOME */
.income-wrap { padding: 0 60px; max-width: 1100px; margin: 0 auto; }
.income-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 18px 24px;
  border: 1px solid var(--border);
  background: var(--card);
  margin-bottom: 2px;
  transition: background 0.2s;
}
.income-row:hover { background: var(--card2); }
.income-l { font-size: 14px; font-weight: 500; }
.income-note { font-size: 12px; color: var(--muted); margin-top: 2px; font-style: italic; }
.income-r { font-family: 'Bebas Neue', sans-serif; font-size: 22px; color: var(--gold); letter-spacing: 1px; }

/* TIMELINE */
.tl-wrap { padding: 0 60px; max-width: 1100px; margin: 0 auto; position: relative; }
.tl-wrap::before {
  content: '';
  position: absolute; left: 88px; top: 0; bottom: 0; width: 1px;
  background: linear-gradient(to bottom, var(--gold), var(--accent), var(--pink), var(--green));
  opacity: 0.25;
}
.tl-row {
  display: flex; gap: 28px;
  margin-bottom: 32px; align-items: flex-start;
}
.tl-num {
  width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-family: 'DM Mono', monospace; font-size: 12px; font-weight: 500;
  position: relative; z-index: 1; margin-top: 2px;
}
.tl-body {}
.tl-wk { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 2px; color: var(--muted); text-transform: uppercase; }
.tl-task { font-family: 'Bebas Neue', sans-serif; font-size: 20px; letter-spacing: 1px; margin: 3px 0 5px; }
.tl-desc { font-size: 13px; font-weight: 300; color: rgba(224,219,211,0.5); line-height: 1.6; }

/* RM FOOTER */
.rm-footer {
  text-align: center; padding: 60px;
  border-top: 1px solid var(--border);
  margin-top: 60px;
}
.rm-footer-text {
  font-family: 'DM Mono', monospace;
  font-size: 11px; letter-spacing: 2px;
  color: var(--muted); text-transform: uppercase;
  line-height: 2;
}
.rm-footer-text span { color: var(--gold); }

/* ─── RESPONSIVE ─── */
@media (max-width: 700px) {
  .hero { padding: 90px 24px 60px; }
  .section { padding: 60px 24px; }
  .pull-quote, .cta-closer { padding: 60px 24px; }
  .phase-section { padding: 40px 24px 0; }
  .apps-label { padding: 0 24px; }
  .apps-strip { margin: 0 24px; }
  .rm-divider { margin: 40px 24px; }
  .income-wrap { padding: 0 24px; }
